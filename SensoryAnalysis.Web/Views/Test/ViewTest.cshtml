@model TestResponse
@{
    ViewBag.Title = Model.Name;
    string type = Model.TestType switch
    {
        TestTypes.Triangular => "triangular",
        TestTypes.DuoTrio => "duo-trio",
        _ => ""
    };
}

<h2>@(Model.Name)</h2>

<p>Teste @(type)</p>
<p>Criado em: @(Model.CreatedAt.ToString("dd/MM/yyyy"))</p>
@if (Model.NameOfSample1 is not null && Model.NameOfSample2 is not null)
{
    <p>Amostra 1: @(Model.NameOfSample1)</p>
    <p>Amostra 2: @(Model.NameOfSample2)</p>
}
<a asp-controller="Test" asp-action="TestRecordPDF" asp-route-id="@(Model.Id)">Baixar fichas</a>
<a asp-controller="Test" asp-action="SamplePaperSheetPDF" asp-route-id="@(Model.Id)">Baixar papéizinhos</a>

<p>
    Adicionar julgadores:
    <span> </span><a asp-controller="Test" asp-action="AddJudger" asp-route-id="@(Model.Id)" asp-route-amount="1">1</a><span> </span>
    <span> </span><a asp-controller="Test" asp-action="AddJudger" asp-route-id="@(Model.Id)" asp-route-amount="5">5</a><span> </span>
    <span> </span><a asp-controller="Test" asp-action="AddJudger" asp-route-id="@(Model.Id)" asp-route-amount="10">10</a><span> </span>
</p>


<table>
    <tr>
        <th>Nº</th>
        <th>Amostras</th>
        <th>Números</th>
        <th>Resposta</th>
        <th>Ações</th>
    </tr>
    @for (int i = 0; i < Model.Judgers.Count; i++)
    {
        JudgerResponse judger = Model.Judgers[i];
        string samples = "";
        List<(int number, bool isSelected)> sampleOptions = [];
        @* sampleOptions.Add((-1, judger.Answer == null)); *@

        foreach (Sample sample in judger.Samples)
        {
            if (sample.SampleType == SampleTypes.Sample1)
            {
                samples += "1";
            }
            else
            {
                samples += "2";
            }
            sampleOptions.Add((sample.Number, judger.Answer == sample.Number));
        }

        string numbers = string.Join(" - ", judger.Samples.Select(s => s.Number.ToString()));

        <tr>
            <td>@(i + 1)</td>
            <td>@(samples)</td>
            <td>@(numbers)</td>
            <td>
                <select name="answer" id="@(judger.Id)Answer">
                    <option value="-1"> - </option>
                    @foreach ((int number, bool isSelected) sampleOption in sampleOptions)
                    {
                        string displayNumber = (sampleOption.number == -1) ? " - " : sampleOption.number.ToString();
                        if (sampleOption.isSelected)
                        {
                            <option value="@(sampleOption.number)" selected="selected">@(displayNumber)</option>
                        }
                        else
                        {
                            <option>@(displayNumber)</option>
                        }
                    }

                </select>

                <a style="display:none;"
                   id="@(judger.Id)SubmitUrl"
                   asp-controller="Test"
                   asp-action="SubmitAnswer"
                   asp-route-testId="@(Model.Id)"
                   asp-route-judgerId="@(judger.Id)">
                </a>

                <button class="small-button" id="@(judger.Id)Submit">Salvar</button>

                <script>
                    document.getElementById("@(judger.Id)Submit").addEventListener("click", async () => {
                        const url = document.getElementById("@(judger.Id)SubmitUrl");
                        const dropdown = document.getElementById("@(judger.Id)Answer");
                        await fetch(url.getAttribute("href") + "&answer=" + dropdown.value, { method: "POST" });
                    });
                </script>

            </td>
            <td>
                <a href="Remove judger" id="@(judger.Id)">Remover</a>

                <a id="@(judger.Id)AreYouSure"
                   style="display: none;"
                   asp-controller="Test"
                   asp-action="RemoveJudgerFromTest"
                   asp-route-testId="@(Model.Id)"
                   asp-route-judgerId="@(judger.Id)">Tem certeza?</a>

                <script>
                    @if (i == 0)
                    {
                          <text>
                            let link = document.getElementById("@(judger.Id)");
                            let sure = document.getElementById("@(judger.Id)AreYouSure");
                          </text>
                    }
                    else
                    {
                          <text>
                            link = document.getElementById("@(judger.Id)");
                            sure = document.getElementById("@(judger.Id)AreYouSure");
                          </text>
                    }

                    link.addEventListener("click", (event) => {
                        if (link.getAttribute("href") == "Remove judger") {
                            event.preventDefault();
                        }
                        link.innerHTML = sure.innerHTML;
                        link.setAttribute("href", sure.getAttribute("href"));
                    });
                </script>

            </td>
        </tr>
    }
</table>

<h2>Resultado</h2>

<table>
    @{
        TestResult result = ViewBag.Result;
    }

    <tr>
        <td>Quantidade de julgadores</td>
        <td>@(result.TotalJudgers)</td>
    </tr>
    <tr>
        <td>Quantidade de respostas</td>
        <td>@(result.TotalAnswers)</td>
    </tr>
    <tr>
        <td>Respostas corretas</td>
        <td>@(result.CorrectAnswers)</td>
    </tr>
    <tr>
        <td>Respostas incorretas</td>
        <td>@(result.WrongAnswers)</td>
    </tr>
    <tr>
        <td>Mínimo para relevância</td>
        <td>@(result.MinimumForRelevance)</td>
    </tr>
    <tr>
        <td>Tem relevância?</td>
        <td>@((result.HasRelevance) ? "Sim" : "Não")</td>
    </tr>
</table>

@if (Model.TestType == TestTypes.Triangular)
{
    <p><a href="~/home/about#triangular">Como o resultado é calculado?</a></p>
}